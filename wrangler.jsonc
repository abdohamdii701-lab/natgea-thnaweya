{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "natgea-thnaweya",
  "compatibility_date": "2026-07-28",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": ".",
    "exclude": [
      "Stage_New_Search_db.zip",
      "Stage_New_Search.db",
      "Stage_New_Search_Extracted.csv",
      "نسخة البحث الدور الأول 2026 - نظام حديث.accdb",
      "*.accdb",
      "*.db",
      "scratch/**"
    ]
  }
}
